# Kötelező: állíts be erős, egyedi értékeket, és a kész .env fájlt ne commitold.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=csereld_le_egy_hosszu_egyedi_jelszora
APP_SECRET=csereld_le_legalabb_32_karakteres_veletlen_titokra

# Opcionális: ha a frontend nem ugyanerről az originről fut.
# FRONTEND_ORIGINS=https://pelda.hu

# Opcionális, abszolút SQLite útvonal.
# DATABASE_PATH=/var/lib/joga-foglalo/yoga_app.db

# Opcionális: automatikus foglalási e-mailek Brevo vagy más SMTP szolgáltatón keresztül.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=Brevo-felhasználónév
# SMTP_PASSWORD=Brevo-SMTP-kulcs
# SMTP_FROM=jelentkezes@pelda.hu
# SMTP_USE_TLS=true
